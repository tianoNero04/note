# =========================
# Custom Ignores
# =========================

# 忽略所有以 . 开头的隐藏文件和文件夹
.*
# 但不要忽略 .gitignore 本身
!.gitignore

其他/
temp/
tmp/

# =========================
# macOS
# =========================

# Finder
.DS_Store
.AppleDouble
.LSOverride

# Icon cache
Icon?

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# =========================
# Obsidian
# =========================

.obsidian/workspace
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/indexed-db/

# Plugin temp/cache (Optional: uncomment if you want to sync plugin settings)
# .obsidian/plugins/*/data.json

# =========================
# VSCode
# =========================

.vscode/

# =========================
# Node.js
# =========================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

